table Seleccion_Inicio
	/// Año seleccionado para comparar extremos; tabla sin relaciones.
	column ANIO
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: [ANIO]

	partition Seleccion_Inicio = calculated
		mode: import
		source = SELECTCOLUMNS(GENERATESERIES(1997, 2025, 1), "ANIO", [Value])
