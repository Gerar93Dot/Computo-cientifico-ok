model Model
	culture: es-MX
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: es-MX
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["RutaDatos","dim_entidad","dim_fecha","atus_anual_api","dim_tipo_victima"]

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DaxQueryView_Desktop","DevMode"]

ref table atus_anual_api
ref table dim_entidad
ref table dim_fecha
ref table dim_tipo_victima


ref table Seleccion_Inicio

ref table Seleccion_Fin
